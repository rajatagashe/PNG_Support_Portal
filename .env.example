# ==============================================================================
# PNG Support Desk Environment Configuration Template
# Copy this file to .env and supply your credentials. Do NOT commit .env to Git!
# ==============================================================================

# System Administrator Password
ADMIN_PASSWORD=change-me

# Support Account Authentication (support.png@amantyatech.com)
SUPPORT_USER_PASSWORD=change-me

# Support mailbox (Microsoft 365). Exchange Online rejects password logins for
# IMAP/SMTP, so the portal signs in with OAuth through an Entra ID app registration.
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# app (default): the app reads the mailbox itself; delegated: an admin signs in once
MS365_AUTH_MODE=

# Application & Database Settings (for docker-compose / bench)
SITE_NAME=helpdesk.localhost
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
